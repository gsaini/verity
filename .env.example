# =============================================================================
# Default LLM provider — pick one. Can be overridden per-run via:
#   - CLI: pnpm test specs/foo.md --provider ollama
#   - Spec frontmatter: provider: groq
#   - HTTP API: POST /runs { "specId": "...", "provider": "groq" }
#
# Options: anthropic | openai | ollama | groq
# =============================================================================
LLM_PROVIDER=anthropic

# -----------------------------------------------------------------------------
# Provider profile: anthropic — native Claude API
# Best vision quality, prompt caching, adaptive thinking.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_EFFORT=high

# -----------------------------------------------------------------------------
# Provider profile: openai — generic OpenAI-compatible endpoint
# Works with OpenAI, plus any other OpenAI-compat server (LM Studio, vLLM,
# OpenRouter, Together) by changing OPENAI_BASE_URL + OPENAI_MODEL.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# Provider profile: ollama — local models, free, no API key required
# Install Ollama (https://ollama.com), pull a vision-capable model, run server.
#
#   ollama pull qwen2.5vl
#   ollama serve
# -----------------------------------------------------------------------------
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5vl

# -----------------------------------------------------------------------------
# Provider profile: groq — fast cloud inference (sub-second latency)
# Get a key at https://console.groq.com — generous free tier.
# -----------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# =============================================================================
# Server
# =============================================================================
PORT=3000
HOST=0.0.0.0

# GitHub webhook (optional — leave blank to skip signature verification)
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# Default target base URL for specs that don't specify one
TARGET_BASE_URL=https://example.com

# =============================================================================
# Browser
# =============================================================================
HEADLESS=true
BROWSER_TIMEOUT_MS=30000
MAX_AGENT_STEPS=40

# =============================================================================
# Storage
# =============================================================================
DATA_DIR=./data
REPORTS_DIR=./reports
SPECS_DIR=./specs
