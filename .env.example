# =============================================================================
# LLM provider — pick one. The agent is model-agnostic.
# =============================================================================
# Options: anthropic | openai
# - anthropic: native Claude API (best vision, prompt caching, adaptive thinking)
# - openai:    any OpenAI-compatible endpoint (OpenAI, Ollama, LM Studio, vLLM, ...)
LLM_PROVIDER=anthropic

# --- Anthropic settings (when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_EFFORT=high

# --- OpenAI-compatible settings (when LLM_PROVIDER=openai) ---
# For OpenAI:        OPENAI_BASE_URL=https://api.openai.com/v1, model=gpt-4o
# For Ollama (local): OPENAI_BASE_URL=http://localhost:11434/v1, model=qwen2.5-vl, key=ollama
# For LM Studio:     OPENAI_BASE_URL=http://localhost:1234/v1, key=anything
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# =============================================================================
# Server
# =============================================================================
PORT=3000
HOST=0.0.0.0

# GitHub webhook (optional — leave blank to skip signature verification)
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# Default target base URL for specs that don't specify one
TARGET_BASE_URL=https://example.com

# =============================================================================
# Browser
# =============================================================================
HEADLESS=true
BROWSER_TIMEOUT_MS=30000
MAX_AGENT_STEPS=40

# =============================================================================
# Storage
# =============================================================================
DATA_DIR=./data
REPORTS_DIR=./reports
SPECS_DIR=./specs
